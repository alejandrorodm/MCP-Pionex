# --- Credenciales (nunca las metas en el chat; solo en el entorno del servidor) ---
PIONEX_API_KEY=
PIONEX_API_SECRET=

# --- Puertas de capacidad (todas OFF por defecto = solo lectura) ---
PIONEX_MCP_TRADING_ENABLED=false
PIONEX_MCP_BOTS_ENABLED=false
PIONEX_MCP_EARN_ENABLED=false

# --- Límites duros (los fija el operador; la IA no puede cambiarlos) ---
PIONEX_MCP_MAX_ORDER_NOTIONAL=100
PIONEX_MCP_MAX_PRICE_DEVIATION_PCT=10
# PIONEX_MCP_SYMBOL_WHITELIST=BTC_USDT,ETH_USDT

# --- Confirmación en dos fases ---
PIONEX_MCP_CONFIRMATION_TTL=120

# --- Auditoría ---
PIONEX_MCP_AUDIT_LOG=~/.mcp_pionex/audit.jsonl
