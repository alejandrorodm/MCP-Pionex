# --- Credentials (never paste them in a chat; only in the server environment) ---
PIONEX_API_KEY=
PIONEX_API_SECRET=

# --- Capability gates (all OFF by default = read-only server) ---
PIONEX_MCP_TRADING_ENABLED=false
PIONEX_MCP_BOTS_ENABLED=false
PIONEX_MCP_FUTURES_ENABLED=false   # futures grids need BOTS_ENABLED too
PIONEX_MCP_EARN_ENABLED=false

# --- Hard limits (set by the operator; the AI cannot change them) ---
PIONEX_MCP_MAX_ORDER_NOTIONAL=100
PIONEX_MCP_MAX_PRICE_DEVIATION_PCT=10
PIONEX_MCP_MAX_LEVERAGE=3
# PIONEX_MCP_SYMBOL_WHITELIST=BTC_USDT,ETH_USDT

# --- Two-phase confirmation ---
PIONEX_MCP_CONFIRMATION_TTL=120

# --- Audit ---
PIONEX_MCP_AUDIT_LOG=~/.mcp_pionex/audit.jsonl
